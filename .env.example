# Скопируйте в .env и замените CHANGE_ME случайным локальным паролем.
# .env не входит в Git. Используйте только учебные данные.
POSTGRES_DB=getfast
POSTGRES_USER=getfast
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
JWT_SIGNING_KEY=CHANGE_ME
SEED_COURIER_EMAIL=courier@example.invalid
SEED_COURIER_PASSWORD=CHANGE_ME
SEED_DISPATCHER_EMAIL=dispatcher@example.invalid
SEED_DISPATCHER_PASSWORD=CHANGE_ME
